# MongoDB Atlas Cloud Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/busmitra?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=your_super_strong_production_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d

# Server Environment
PORT=5000
NODE_ENV=production

# Frontend Netlify URL (CORS allowed origin, comma-separated if multiple)
CLIENT_URL=https://your-site.netlify.app
